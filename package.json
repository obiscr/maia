{
  "name": "maia",
  "version": "0.1.0",
  "description": "Self-hosted workflow orchestration and execution service (DAG) for long-running automation you can observe, debug, and replay.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/obiscr/maia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obiscr/maia.git"
  },
  "bugs": {
    "url": "https://github.com/obiscr/maia/issues"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "dag",
    "automation",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "start": "next start",
    "shadcn:update": "npx --yes shadcn@latest add --all --overwrite",
    "lint": "oxlint",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "type-check": "tsc --noEmit",
    "check:client-imports": "node scripts/check-client-imports.mjs",
    "check:framework": "node scripts/check-framework-boundaries.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "check-all": "pnpm run lint && pnpm run type-check && pnpm run check:client-imports && pnpm run check:framework && pnpm run build && pnpm run test:e2e",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.15.15",
    "@monaco-editor/react": "^4.7.0",
