    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.12.0",
    "postcss": "^8",
    "prettier": "^3.7.4",
    "prisma": "7.2.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "@prisma/engines",
      "better-sqlite3",
      "prisma",
      "sharp"
    ]
  }
}
