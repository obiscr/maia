# -----------------------------------------------------------------------------
# Maia env example (for Docker / self-host).
#
# Goal:
# - Put the most important knobs FIRST.
# - Keep optional knobs commented out by default (copy/paste when needed).
#
# Notes:
# - Local dev usually does NOT require any env.
# - Docker Compose only auto-loads `.env` by default; if you use `.env.production`,
#   pass it explicitly: `docker compose --env-file .env.production up -d --build`.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# REQUIRED / strongly recommended (prod & self-host)
# -----------------------------------------------------------------------------
# 1) Runner auth token (App <-> Runner).
# - Required for real deployments.
# - Must match between `maia` and `runner` services.
RUNNER_TOKEN=

# 2) Encryption key for secrets-at-rest (user API keys, SMTP password, etc).
# - Recommended for production.
# - If empty, Maia will auto-generate a key on first run and store it under the data dir.
# - Format: base64 32 bytes (recommended) or hex 64 chars.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SETTINGS_ENCRYPTION_KEY=

# 3) Break-glass admin recovery (required in production if you want /setup/repair).
#SETUP_REPAIR_TOKEN=

# -----------------------------------------------------------------------------
# Docker Compose / data directory (optional)
# -----------------------------------------------------------------------------
# Docker Hub images (optional; used by docker-compose.release.yml)
# - Leave empty to use the defaults in the compose file.
# - Set these if you publish Maia under a different Docker Hub namespace or want to pin a tag.
#MAIA_IMAGE=obiscr/maia:latest
#MAIA_RUNNER_IMAGE=obiscr/maia-runner:latest
#MAIA_SANDBOX_IMAGE=obiscr/maia-sandbox:latest

# Maia data mount mode:
# - Default (recommended): use Docker named volume (no extra config needed)
#   - MAIA_DATA_MOUNT_TYPE=volume
#   - Leave MAIA_HOST_DATA_DIR empty
#
# - Optional: bind-mount a host directory (operator-controlled)
#   - MAIA_DATA_MOUNT_TYPE=bind
#   - MAIA_HOST_DATA_DIR=/absolute/path/on/host
#
# Host path examples for bind mode:
# - macOS: /Users/<user>/Documents/Maia
# - Linux: /home/<user>/Maia or /var/lib/maia
# - Windows: /c/Users/<user>/Documents/Maia (Git-Bash style)
MAIA_DATA_MOUNT_TYPE=volume
MAIA_HOST_DATA_DIR=

# Optional (advanced): lock the instance data directory via env.
# - When set, the Setup wizard cannot change the location (but can still initialize the DB).
# - In Docker Compose, you usually do NOT need to set this (the container default is /app/maia-data).
#MAIA_DATA_DIR=/app/maia-data

# Sandbox container mount strategy (optional):
# - Default: mount whole `maia-data` into sandbox containers (cross-platform; recommended)
# - Strict: minimal mounts (requires bind mode, i.e. MAIA_DATA_MOUNT_TYPE=bind + MAIA_HOST_DATA_DIR set)
MAIA_RUNNER_MOUNT_MODE=default

# Runner debug/hardening knobs (optional):
# - Keep failed sandbox containers for debugging (default: off)
#   - Values: 0/1
#RUNNER_DEBUG_RETAIN_FAILED=0
# Note: retained containers are still cleaned up by TTL/orphan cleanup.
#
# - nofile ulimit for sandbox containers (0 = keep runtime default)
#RUNNER_NOFILE=4096
#
# - Docker Engine API version override (optional; advanced)
#   - Default: auto-negotiate via Docker `/version`
#   - Use only if your environment blocks `/version` or you need to pin a version
#   - Example values: 1.44, 1.52
#RUNNER_DOCKER_API_VERSION=

# Default mount mode when caller doesn't specify (optional):
# - Default: mount whole `maia-data`
# - Strict: minimal mounts (requires RUNNER_DATA_BIND)
#RUNNER_DEFAULT_MOUNT_MODE=default

# Performance & limits (optional; safe to leave commented out)
# Notes (self-host):
# - These env vars apply to the whole instance (system-level), not per-user.
# - Start conservative (1–2) and increase gradually after observing CPU/RAM/IO.
# - In container-isolation mode, higher concurrency also means more containers.
#
# Recommended starting points:
# - Laptop / small VPS: 1–2
# - Desktop / medium server: 2–4
# - Large server: raise gradually with monitoring (CPU/RAM/disk IO).
#
# If you are unsure, leave these unset.
#GLOBAL_RUN_CONCURRENCY=2
#PER_RUN_STEP_CONCURRENCY=2
#DEFAULT_STEP_TIMEOUT_MS=600000
#
# Pre-run URL input downloads:
#INPUT_DOWNLOAD_CONCURRENCY=2
#INPUT_DOWNLOAD_TIMEOUT_MS=60000
#INPUT_DOWNLOAD_MAX_BYTES=52428800
#
# Lock performance settings UI (GitOps-friendly):
# - When enabled, Preferences → System → Performance becomes read-only.
# - Registration + SMTP remain configurable in the UI.
#SYSTEM_PERFORMANCE_LOCKED=0

# NOTE: `SETTINGS_ENCRYPTION_KEY` is declared at the top (required/recommended section).

# -----------------------------------------------------------------------------
# Auth / registration
# -----------------------------------------------------------------------------
# Rate limits (optional; safe to leave commented out)
#AUTH_RATE_LIMIT_SIGNUP_WINDOW_MS=60000
#AUTH_RATE_LIMIT_SIGNUP_PER_IP=10
#AUTH_RATE_LIMIT_PASSWORD_FORGOT_WINDOW_MS=60000
#AUTH_RATE_LIMIT_PASSWORD_FORGOT_PER_IP=10
#AUTH_RATE_LIMIT_PASSWORD_FORGOT_PER_IP_EMAIL=5

# Password hashing (optional; tune only if you know what you're doing)
# Scrypt params: N = 2^(AUTH_PASSWORD_SCRYPT_N_LOG2), r, p.
# You can also raise maxmem if you see "memory limit exceeded" errors.
#AUTH_PASSWORD_SCRYPT_N_LOG2=14
#AUTH_PASSWORD_SCRYPT_R=8
#AUTH_PASSWORD_SCRYPT_P=1
#AUTH_PASSWORD_SCRYPT_MAXMEM_MB=128

# NOTE: `SETUP_REPAIR_TOKEN` is declared at the top (required/recommended section).

# -----------------------------------------------------------------------------
# SMTP (optional; configurable in Preferences → System)
# -----------------------------------------------------------------------------
# Note: SMTP password configured in UI is stored encrypted at rest (DB).

# -----------------------------------------------------------------------------
# Platform API retention / cleanup (Operation + Idempotency)
# -----------------------------------------------------------------------------
# How often to run background cleanup (best-effort, triggered by API traffic).
#OPS_CLEANUP_EVERY_MINUTES=60
# Keep completed operations for N days.
#OPS_TTL_DAYS=30
# Keep idempotency keys for N days (after that, clients must use a new key).
#IDEMPOTENCY_TTL_DAYS=7
# If an operation stays RUNNING with no updates past N days, auto-mark FAILED (prevents eternal RUNNING).
#OPS_RUNNING_MAX_AGE_DAYS=2
# Heartbeat interval (ms) for long-running operations (best-effort progress updates).
#OPS_OPERATION_HEARTBEAT_MS=30000
# In-process cleanup scheduler tick interval (ms).
#OPS_CLEANUP_ENGINE_TICK_MS=30000
